<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only to download the speech model once (SpeechModel.install); audio and text
         never leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceInbox">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Record" on a long press of the icon. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- A second launcher icon that starts recording at once. Pinned shortcuts need a
             permission MIUI/HyperOS often denies sideloaded apps; a launcher icon does not.
             Its own task, so every tap reaches MainActivity (see RecordActivity). -->
        <activity
            android:name=".ui.RecordActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_record"
            android:label="@string/record_label"
            android:noHistory="true"
            android:taskAffinity="t7helpers.voiceinbox.record"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
